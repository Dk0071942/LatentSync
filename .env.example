# Environment Configuration for RIFE App
# Copy this file to .env and modify values as needed for your environment

# Authentication Settings
# Leave empty to disable authentication (default for local development)
# Set values to enable HTTP Basic Authentication
AUTH_USERNAME=""
AUTH_PASSWORD=""

# Example: Enable authentication for production
# AUTH_USERNAME="admin"
# AUTH_PASSWORD="your-secure-password-here"

# Notes:
# - Authentication is automatically disabled when either username or password is empty
# - Both applications (gradio_app.py and ECCV2022-RIFE/rife_app/app.py) use these variables
# - For production deployments, set these as environment variables in your hosting platform